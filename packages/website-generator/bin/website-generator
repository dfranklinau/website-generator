#!/usr/bin/env node
const args = process.argv.slice(2);
const websiteGenerator = require('../dist/index.js').default;
const packagejson = require('../package.json');

if (args.includes("--help") || args.includes("-h")) {
  process.stdout.write(`\
Usage: website-generator <command> [options]

Commands:
  build:     Build the static website.
  serve      Run a local server and rebuild when changes are made.
  init       Create an example website.

Options:
  -h, --help     Show this help message.
  -v, --version  Show the version number.
`);
  process.exit(0);
}

if (args.includes("--version") || args.includes("-v")) {
  process.stdout.write(`\
${packagejson.version}
`);
  process.exit();
}

switch (args[0]) {
  case "build":
    websiteGenerator.generate();
  case "serve":
    websiteGenerator.serve();
  case "init":
    websiteGenerator.init();
  default:
    process.stdout.write(`\
Please specify a command when using website-generator. Run \`website-generator --help\` for usage.
`);
    process.exit();
}
