{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "removeComments": true,
    "rootDir": "./src",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./typings"]
  },
  "exclude": ["./node_modules"],
  "include": ["./src/**/*.ts", "./typings/**/*.d.ts"]
}
